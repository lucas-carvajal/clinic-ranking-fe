# Backend API (Go service). Required for /api/proxy, server actions, proxy.ts admin checks.
BACKEND_URL=http://localhost:8080

# Must match Set-Cookie name from POST /auth/login. See README + docs/admin-auth.md.
SESSION_COOKIE_NAME=admin_auth_token

# Public site origin (dev: same as Next). Used when SEO/sitemap/robots consume SITE_URL (T21B+).
SITE_URL=http://localhost:3000

# Optional. Reserved for client analytics; leave empty if unused.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
